{
    "name": "ernestdefoe/maintenance",
    "description": "Run migrations and publish assets from the Flarum admin dashboard — no terminal needed.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "maintenance",
        "migrations",
        "assets"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39523-maintenance-for-flarum-2",
        "issues": "https://github.com/ernestdefoe/maintenance/issues",
        "source": "https://github.com/ernestdefoe/maintenance"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Maintenance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Maintenance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Maintenance",
            "category": "feature",
            "icon": {
                "name": "fas fa-screwdriver-wrench",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
